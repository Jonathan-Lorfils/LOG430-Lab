@startuml VueDeploiement
skinparam componentStyle rectangle
skinparam node {
    BackgroundColor #EEF
    BorderColor Black
}

node "PC Magasin 1" {
    artifact "Navigateur Web 1"
}

node "PC Magasin 2" {
    artifact "Navigateur Web 2"
}

node "PC Magasin 3" {
    artifact "Navigateur Web 3"
}

node "PC Magasin 4" {
    artifact "Navigateur Web 4"
}

node "PC Magasin 5" {
    artifact "Navigateur Web 5"
}

node "Serveur (VM)" {
    artifact "Application POS"
    database "PostgreSQL"
} 

"Navigateur Web 1" -- "Application POS"
"Navigateur Web 2" -- "Application POS"
"Navigateur Web 3" -- "Application POS"
"Navigateur Web 4" -- "Application POS"
"Navigateur Web 5" -- "Application POS"
"Application POS" -- "PostgreSQL"

@enduml
