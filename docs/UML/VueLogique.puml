@startuml VueLogique

class ParentStore {
  - nom : String
  - adresse : String
}

class Warehouse {
  - nom : String
  - adresse : String
}

class Store {
  - nom : String
  - adresse : String
}

class Product {
  - nom : String
}

class Category {
  - name : String
}

class Stock {
  - quantity : int
}

class Sale {
  - saleDate : Date
  - subTotal : float
}

class SaleLine {
  - price : float
  - quantity : int
}

class Replenishment {
  - requestedQuantity : int
  - statut : String
}

class Customer {
  - firstName : String
  - lastName : String
  - email : String
  - password : String
  - phone : String
  - address : String
}

class Cart {
  - createdAt : Date
  - status : String
}

class CartItem {
  - price : float
  - quantity : int
}

class Order {
  - orderDate : Date
  - totalAmount : float
  - status : String
}

class OrderLine {
  - quantity : int
  - price : float
}

' Relations existantes
Category "1" -- "*" Product : contains >
ParentStore "1" -- "1" Warehouse : manage >
ParentStore "1" -- "*" Store : manages >
Store "1" -- "*" Stock : has >
Store "1" -- "*" Sale : generates >
Warehouse "1" -- "*" Stock : has >
Product "1" -- "*" Stock : has >"
Product "1" -- "*" SaleLine : sold in >"
Stock "1" -- "*" Replenishment : generates >
Sale "1" -- "*" SaleLine : contains >

' Relations e-commerce
Customer "1" -- "1" Cart : owns >
Cart "1" -- "*" CartItem : contains >
CartItem "*" -- "1" Product : refers to >
Customer "1" -- "*" Order : places >
Order "1" -- "*" OrderLine : contains >
Product "1" -- "*" OrderLine : appears in >

@enduml
